{
  "name": "veren",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "cli": "node scripts/commander.mjs",
    "check": "pnpm check:plugins && pnpm check:entries && pnpm check:platform-modules && pnpm check:bundles && pnpm check:src-artifacts && pnpm check:gate-selftest",
    "check:bundles": "node scripts/check-bundle-patch-rows.mjs",
    "check:entries": "node scripts/check-entry-points.mjs",
    "check:gate-selftest": "vitest run --dir scripts/tests",
    "check:platform-modules": "node scripts/check-platform-modules.mjs",
    "check:plugins": "node scripts/check-plugin-manifests.mjs",
    "check:src-artifacts": "node scripts/check-src-artifacts.mjs",
    "market:build": "node market/build.mjs",
    "market:deploy": "node market/deploy.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-group": "~1.0.5",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.4",
    "zod": "4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/cordis": "^4.0.5",
      "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
      "zod": "4.4.3"
    }
  }
}
