# 插件市场索引的生成产物与缓存 / generated plugin market index and its cache
/market/site/
/market/.plugin-market-cache/

# 临时会话日志与探针 / temporary session logs and probes
.tmp-*
*.log
/tmp-*.ps1
/scripts-tmp-*

# 根目录随手截的调试图只留本地 / ad-hoc debug screenshots at repo root stay local
/*.png
/*.jpg
/*.jpeg
/*.webp

# 0.1.10 旧版面板调试截图保留在本地 / legacy 0.1.10 panel captures stay local
packages/graph/flow-canvas-panel/docs/shot-*.png

# 误跑 tsc 时落在源码旁的编译产物 / stray tsc output next to sources
packages/**/src/*.js
packages/**/src/*.js.map
packages/**/src/index.d.ts
packages/**/src/index.d.ts.map
packages/**/src/types.d.ts
packages/**/src/types.d.ts.map