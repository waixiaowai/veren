/target
node_modules
dist
# 构建产物目录（dist / lib）不入库：源码进 git，产物进包（files 白名单），
# 打包前由各包的 prepack 自动构建（pnpm pack 触发）。market/lib 是手写源码
# （market 不是 npm 包），不在 plugins/packages 前缀下，不受影响。唯一例外：
# 被以 git 仓库/源码路径形式直接安装的包无法触发 prepack，产物必须提交——
# 见 AGENTS.md「稳定测试节点 · 装插件」条目，不得拿它当不构建的挡箭牌。
# Build artifact directories (dist / lib) stay out of git: sources are
# committed, artifacts ship inside the package (files whitelist) and are
# rebuilt by each package's prepack before packing (triggered by pnpm pack).
# market/lib is hand-written (market is not an npm package) and lives outside
# the plugins/packages prefixes, so it is untouched. The single exception: a
# package installed directly as a git checkout cannot run prepack, so its
# artifacts must be committed — see the install entry in AGENTS.md; do not
# invoke it as a pretext for skipping builds.
plugins/**/lib
packages/**/lib
*.tsbuildinfo
# sourcemap 一律是构建伴生产物，与 dist/lib 同待遇，不入库 / sourcemaps are build companions, treated like dist/lib, never committed
*.map
/deepseek
deepseek/
# 外来仓库克隆（自带 .git），与本仓库无关 / foreign repo clones (own .git), unrelated to this repo
/dsh-workbuddy-oauth/
.workbuddy
# 临时产物不应落在仓库里：会被备份与版本控制误带入
# Temp artifacts must never live inside the repo: backups and VCS pick them up accidentally
.pnpm-store/
.tmp-*/
dist-*/
# 打包产物不入库 / Build artifacts must never be committed
*.tgz
*.tar.gz
*.zip
.e2e

# 本地打包/验收产物与临时目录 / local packaging and verification artifacts
dist-tgz/
/tarballs/
/flow-canvas-panel/
.dsh-desktop-profile-backup-*/

# 插件市场索引的生成产物与缓存 / generated plugin market index and its cache
/market/site/
/market/.plugin-market-cache/
*.env
# 临时会话日志与探针 / temporary session logs and probes
.tmp-*
*.log
/tmp-*.ps1
/scripts-tmp-*

# 根目录随手截的调试图只留本地 / ad-hoc debug screenshots at repo root stay local
/*.png
/*.jpg
/*.jpeg
/*.webp

# 0.1.10 旧版面板调试截图保留在本地 / legacy 0.1.10 panel captures stay local
packages/graph/flow-canvas-panel/docs/shot-*.png

# 误跑 tsc / 编辑器"保存即编译"时落在源码旁的编译产物：与同名 .ts 并排的
# .js、.js.map、.d.ts、.d.ts.map 都是生成物，交付产物只应出现在 dist（或 lib）。
# 规则只覆盖 src/ 顶层的这四种形态，不做一刀切：插件里真正手写的 .js 在
# scripts/、ui/、web/client/、tests/ 下，纯 ambient 声明（如
# plugins/cms-bridge/src/client/css.d.ts）在更深一层，两者都不会被误伤。
# 守卫 scripts/check-src-artifacts.mjs 负责在复发时报错。
#
# Stray tsc / editor "compile on save" output next to sources: a .js, .js.map,
# .d.ts or .d.ts.map sitting beside its same-named .ts is generated — shippable
# artifacts belong in dist (or lib). The patterns only cover the top level of
# src/ on purpose, so they are not a blanket ignore: hand-written plugin .js
# lives in scripts/, ui/, web/client/ and tests/, and pure ambient declarations
# (e.g. plugins/cms-bridge/src/client/css.d.ts) sit one level deeper.
# scripts/check-src-artifacts.mjs is the guard that fails when this regrows.
packages/**/src/*.js
packages/**/src/*.js.map
packages/**/src/*.d.ts
packages/**/src/*.d.ts.map
plugins/**/src/*.js
plugins/**/src/*.js.map
plugins/**/src/*.d.ts
plugins/**/src/*.d.ts.map
apps/**/src/*.js
apps/**/src/*.js.map
apps/**/src/*.d.ts
apps/**/src/*.d.ts.map
# 真机自测临时产物 / real-env probe artifacts
.headless-out.txt
.headless-t1.txt
.verify-out.txt
.dsh-web-3080.log
