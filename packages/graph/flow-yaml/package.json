{
  "name": "@deepseek-ai/dsh-graph-flow-yaml",
  "version": "0.1.2",
  "description": "Use when flow definitions live in YAML files and should be loaded into the flow engine at plugin startup: it maps YAML documents to FlowDefinitions (id, nodes, edges, output slot references), validates the shape loudly, registers each flow through ctx.effect for reverse-order unregistration, and reloads on config change; skip it when flows are built in code or stored by @deepseek-ai/dsh-graph-flow-storage.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    }
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "vitest run --no-fsModuleCache",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-graph-core": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-api": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-engine": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@veren/core": "workspace:*",
    "@veren/yaml-parser": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-graph-core": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-api": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-engine": "workspace:*"
  }
}
