{
  "name": "@deepseek-ai/dsh-graph-node-tool",
  "version": "0.1.2",
  "description": "Use when a flow must invoke a tool already registered in the DSH tool registry (ctx.tools, e.g. bash/fs/web) as a flow node: it adapts resolved flow inputs into tool arguments, runs the call through the full tools pipeline (sandbox, policies, timeout), and projects the canonical JSON value into blackboard slots; skip it when the flow only needs the built-in noop/fail/echo/subflow fixtures of @deepseek-ai/dsh-graph-flow-engine.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    }
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-graph-core": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-api": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-engine": "workspace:*",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@veren/core": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-graph-core": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-api": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-approval": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-engine": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-storage": "workspace:*",
    "@deepseek-ai/dsh-graph-flow-yaml": "workspace:*",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@veren/yaml-parser": "workspace:*"
  }
}
