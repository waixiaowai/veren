{
  "name": "@deepseek-ai/dsh-graph-bundle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Use when a DSH profile should mount the whole graph plugin family (DAG kernel, flow engine, YAML flow loading, storage persistence, the generic tool node and the model-facing graph tools) in one step; skip it when you compose a host from individual @deepseek-ai/dsh-graph-* packages or choose your own storage backend and flow source.",
  "license": "MIT",
  "files": [
    "cordis.patch.yml",
    "tarballs",
    "README.md",
    "README.cn.md",
    "README.i18n.yaml",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@veren/core": "file:./tarballs/veren-core-0.1.0.tgz",
    "@deepseek-ai/dsh-graph-core": "file:./tarballs/deepseek-ai-dsh-graph-core-0.1.0.tgz",
    "@deepseek-ai/dsh-graph-flow-api": "file:./tarballs/deepseek-ai-dsh-graph-flow-api-0.1.0.tgz",
    "@deepseek-ai/dsh-graph-flow-engine": "file:./tarballs/deepseek-ai-dsh-graph-flow-engine-0.1.0.tgz",
    "@deepseek-ai/dsh-graph-node-tool": "file:./tarballs/deepseek-ai-dsh-graph-node-tool-0.1.0.tgz",
    "@deepseek-ai/dsh-graph-flow-storage": "file:./tarballs/deepseek-ai-dsh-graph-flow-storage-0.1.0.tgz",
    "@deepseek-ai/dsh-graph-flow-yaml": "file:./tarballs/deepseek-ai-dsh-graph-flow-yaml-0.1.0.tgz",
    "@deepseek-ai/dsh-graph-tools": "file:./tarballs/deepseek-ai-dsh-graph-tools-0.1.0.tgz",
    "@veren/yaml-parser": "file:./tarballs/veren-yaml-parser-0.1.0.tgz"
  }
}
