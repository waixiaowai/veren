{
  "name": "@veren/prompt-page",
  "description": "Page runtime over prompt-core and prompt-host-messages: definePage/mountPage bind a declarative page to an external store as an isolated page-session, PageRouter orchestrates navigation with pointer handoff; use as the react-dom/client-equivalent entry, not for domain logic.",
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.cn.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@veren/prompt-core": "workspace:^",
    "@veren/prompt-host-messages": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
