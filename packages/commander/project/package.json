{
  "name": "@veren/commander-project",
  "displayName": "Veren Commander Project",
  "version": "2.1.4",
  "description": "Use when a Cordis plugin needs the veren project root and its .veren.yaml scan config as a context service (verenCliProject): it locates the project root, loads the config through the YAML parser service and provides both; skip it when you parse config yourself.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@veren/commander-core": "workspace:*",
    "@veren/core": "workspace:*",
    "@veren/yaml-parser": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.2",
    "@types/node": "^22.13.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  }
}
