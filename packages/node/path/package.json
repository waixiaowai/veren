{
  "name": "@veren/node-path",
  "displayName": "Veren Node Path",
  "version": "0.1.0",
  "description": "Use when a Cordis-based app or pipeline must build, parse or compare paths through a context service instead of importing node:path directly, so the path flavor (posix/win32) is configurable per deployment.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@veren/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
