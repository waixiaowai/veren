{
  "name": "@veren/compiler-program",
  "version": "0.1.0",
  "description": "Use when a build stage needs a ts.Program (AST, module graph and type checker) built from services already in the context, rather than constructing ts.createProgram by hand.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@veren/core": "workspace:*",
    "@veren/compiler-options": "workspace:*",
    "@veren/compiler-host": "workspace:*"
  }
}
