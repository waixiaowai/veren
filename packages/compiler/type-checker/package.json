{
  "name": "@veren/compiler-type-checker",
  "version": "0.1.0",
  "description": "Use when a build stage must resolve full type information from AST nodes and the checker has to stay from the same source as the program.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.4",
    "@veren/core": "workspace:*",
    "@veren/compiler-program": "workspace:*"
  }
}
