{
  "name": "@veren/admin-ui-kernel",
  "displayName": "Admin UI Kernel",
  "version": "2.1.7",
  "description": "Use when an admin deployment must serve replaceable browser packs: it registers UI packs from their manifests, negotiates the UI contract range, publishes the pre-login and post-login manifests, and resolves pack assets while refusing paths outside a pack directory; skip it when the deployment serves no browser UI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale/*.json",
    "README.md",
    "README.cn.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "@veren/admin-contract": "workspace:^",
    "@veren/admin-kernel": "workspace:^",
    "@veren/admin-ui-contract": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "license": "MIT"
}
