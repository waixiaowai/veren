{
  "name": "@veren/admin-access-rbac",
  "displayName": "Admin Access RBAC",
  "version": "2.1.7",
  "description": "Use when an admin deployment needs the default role-based authorization provider: it owns the role catalog and user-to-role bindings, derives permissions for an authenticated identity, enforces anti-lockout so the last owner cannot be stripped, and registers the role-binding routes; skip it when authorization comes from an external directory service.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale/*.json",
    "README.md",
    "README.cn.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "@veren/admin-api-kernel": "workspace:^",
    "@veren/admin-contract": "workspace:^",
    "@veren/admin-kernel": "workspace:^",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
