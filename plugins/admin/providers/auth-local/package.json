{
  "name": "@veren/admin-auth-local",
  "displayName": "Admin Auth Local",
  "version": "2.2.0",
  "description": "Use when an admin deployment needs local accounts without an external identity provider: it owns users, scrypt password hashes, browser sessions with absolute and idle expiry, one-time API tokens, first-run setup, and the sign-in/user/token routes; skip it when authentication must come from an external OIDC or LDAP provider.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale/*.json",
    "README.md",
    "README.cn.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "@veren/admin-api-kernel": "workspace:^",
    "@veren/admin-contract": "workspace:^",
    "@veren/admin-kernel": "workspace:^",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@veren/admin-api-kernel": "workspace:^",
    "@veren/admin-contract": "workspace:^",
    "@veren/admin-kernel": "workspace:^",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
