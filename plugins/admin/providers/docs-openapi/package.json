{
  "name": "@veren/admin-docs-openapi",
  "displayName": "Admin Docs OpenAPI",
  "version": "2.0.10",
  "description": "Use when a DSH admin deployment must publish generated documentation instead of hand-written specs: it serves the live capability catalog, backend health, a documentation index and the OpenAPI 3.1 document generated from the registered route table; skip it when the deployment already exposes its own docs surface or needs no generated API reference.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale/*.json",
    "README.md",
    "README.cn.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dependencies": {
    "@veren/admin-api-kernel": "workspace:^",
    "@veren/admin-contract": "workspace:^",
    "@veren/admin-kernel": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@veren/admin-api-kernel": "workspace:^",
    "@veren/admin-contract": "workspace:^",
    "@veren/admin-kernel": "workspace:^",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
