{
  "name": "@veren/im-turn",
  "displayName": "Veren IM Turn",
  "description": "Use when the IM family needs the reply engine: one wake becomes one replayable run with a durable record and event timeline, the agent's inbox loads from the conversation domain, a per-agent DSH session (preset-backed when the participant names one) produces the reply, coordination's write gates judge it inside the post, and holds loop back as re-prompts before the run lands in a terminal state (completed/failed/skipped). Consumes im/wake-request from @veren/im-coordination; the im_* tooling lives in @veren/im-tool.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "src/**/*.ts",
    "README.md",
    "README.cn.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {},
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@veren/core": "workspace:*",
    "@veren/im": "workspace:^",
    "@veren/im-conversation": "workspace:^",
    "@veren/im-coordination": "workspace:^",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-brand": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@types/node": "^26.6.5",
    "typescript": "^5.8.3",
    "vitest": "^5.0.4"
  },
  "license": "MIT",
  "version": "3.0.0-rc.3"
}
