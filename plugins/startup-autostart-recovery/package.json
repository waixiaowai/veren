{
  "name": "@veren/startup-autostart-recovery",
  "displayName": "Startup Autostart Recovery",
  "version": "1.0.0",
  "icon": "./icon.svg",
  "description": "Use when work interrupted by an unclean DeepSeek Harness shutdown should resume by itself: the plugin keeps an on-disk clean-exit flag, detects the crash on the next start, looks up the real cause in the desktop crash-log directory, and delivers one recovery prompt to the last active session; it can also register a Windows logon-autostart entry (off by default, one call to enable, one call to remove). Skip it when restarts are always graceful or recovery prompts are not wanted.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/*.js",
    "README.md",
    "README.cn.md",
    "icon.svg",
    "locale/*.json"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {},
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run --no-fsModuleCache"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
    "@veren/startup-autostart": "^1.3.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@veren/startup-autostart": "workspace:^",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
