{
  // Type-checking only: emission is `scripts/build.mjs`, which transpiles each
  // source file with the Harness checkout's own TypeScript.
  //
  // `tsconfig.paths.json` is generated by `scripts/gen-tsconfig-paths.mjs` from
  // the checkout's `tsconfig.base.json`; it carries the complete `@deepseek-ai/*`
  // source alias map plus a pinned `zod`, so this plugin is checked against the
  // real Harness sources rather than against copies of their types.
  //
  // 仅做类型检查：产物由 scripts/build.mjs 用检出仓库自带的 TypeScript 逐文件
  // 转译。tsconfig.paths.json 由脚本从检出仓库的 tsconfig.base.json 生成，带有
  // 完整的 @deepseek-ai/* 源码别名映射并固定 zod，因此本插件是对真实 Harness
  // 源码做类型检查，而不是对着类型副本。
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "composite": false,
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
