{
    "name":  "@veren/app-host",
    "description":  "Use when a DSH profile needs the Veren application framework wired in one place: this host-assembly plugin binds the app registry, page registry, and task center together (app resolver, page mirror, real agent-scoped session port, focus seam) so that installing an app plugin requires no manual cross-service wiring; skip it only when you compose the three services by hand in tests.",
    "version": "0.2.6",
    "private":  true,
    "type":  "module",
    "main":  "./dist/index.js",
    "exports":  {
                    ".":  "./dist/index.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "dist",
                  "README.md",
                  "README.cn.md"
              ],
    "engines":  {
                    "dsh":  "\u003e=0.2.1-rc.2 \u003c0.3.0"
                },
    "dsh":  {

            },
    "scripts":  {
                    "build":  "node scripts/build.mjs",
                    "prepack":  "pnpm run build",
                    "test":  "vitest run",
                    "typecheck":  "tsc --noEmit"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "\u003e=4.0.0",
                             "@deepseek-ai/dsh-agent":  "\u003e=0.2.1-rc.2 \u003c0.3.0",
                             "@deepseek-ai/dsh-llm":  "\u003e=0.2.1-rc.2 \u003c0.3.0",
                             "@deepseek-ai/dsh-session":  "\u003e=0.2.1-rc.2 \u003c0.3.0",
                             "@deepseek-ai/dsh-tools":  "\u003e=0.2.1-rc.2 \u003c0.3.0",
                             "@veren/app-registry":  "workspace:^",
                             "@veren/page-registry":  "workspace:^",
                             "@veren/prompt-host-messages":  "workspace:^",
                             "@veren/task-center":  "workspace:^",
                             "@deepseek-ai/dsh-typert-protocol":  "\u003e=0.2.1-rc.2 \u003c0.3.0",
                             "@deepseek-ai/dsh-agent-default-model":  "\u003e=0.2.1-rc.2 \u003c0.3.0",
                             "@deepseek-ai/dsh-storage":  "\u003e=0.2.1-rc.2 \u003c0.3.0",
                             "@deepseek-ai/dsh-storage-domain":  "\u003e=0.2.1-rc.2 \u003c0.3.0",
                             "@deepseek-ai/dsh-storage-json":  "\u003e=0.2.1-rc.2 \u003c0.3.0"
                         },
    "dependencies":  {
                         "@deepseek-ai/schemastery":  "^3.18.4"
                     },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.5",
                            "@deepseek-ai/dsh-agent":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-llm":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-scope":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-session":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-tools":  "0.2.1-rc.2",
                            "@veren/app-registry":  "workspace:^",
                            "@veren/page-registry":  "workspace:^",
                            "@veren/prompt-host-messages":  "workspace:^",
                            "@veren/prompt-page":  "workspace:^",
                            "@veren/task-center":  "workspace:^",
                            "typescript":  "^5.6.0",
                            "vitest":  "^5.0.4",
                            "@deepseek-ai/dsh-typert-protocol":  "0.2.1-rc.2",
