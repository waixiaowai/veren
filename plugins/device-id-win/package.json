{
  "name": "@veren/device-id-win",
  "displayName": "Veren Device ID (Windows)",
  "version": "2.1.3",
  "description": "Use on Windows only as the platform plugin for @veren/device-id: it collects the stable-tier hardware fingerprint (SMBIOS UUID + baseboard serial via PowerShell CIM) and anchors the id in the HKCU registry (Software\\Veren\\DeviceId) as the out-of-band recovery tier; skip it on non-Windows hosts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.cn.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "test": "vitest run --no-fsModuleCache"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@veren/core": "workspace:*",
    "@veren/device-id": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^26.6.5",
    "vitest": "^5.0.4"
  }
}
