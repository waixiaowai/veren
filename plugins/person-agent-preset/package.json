{
  "name": "@veren/person-agent-preset",
  "displayName": "管家-预设",
  "version": "0.2.6",
  "icon": "./icon.svg",
  "description": "Use when a DSH deployment needs the bridge between the human and DSH: it registers the \"person-agent\" preset through ctx.agentPresets at runtime, composing a delegating chief-of-staff persona (understands the need, metacognition first, plain Simplified Chinese, hands work to sessions it creates) with workspace and session maintenance tools always on, plus a bundled human-writing skill that keeps user-facing text readable; skip it when sessions must never create or route other sessions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.cn.md",
    "icon.svg",
    "locale/*.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@veren/person-agent-dynamic-context": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@vitest/utils": "3.2.7",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0-rc.2",
    "@veren/person-agent-dynamic-context": "*"
  }
}
