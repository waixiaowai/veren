{
  "name": "@veren/person-agent-dynamic-context",
  "displayName": "Person Agent Dynamic Context",
  "version": "0.2.7",
  "description": "Use when a Person Agent preset's sessions need working memory: it appends a sourced snapshot message at each step preparation with the awaited preset roster and per-workspace session facts (title, preset, provider/model, running state; archived filtered), adding to the session only when the values change; skip it when sessions should not see the roster or workspaces.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.cn.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-rc.2",
    "@types/node": "^26.6.0",
    "@vitest/utils": "3.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
