{
  "name": "@veren/task-workbench",
  "description": "Reference Veren application: registers the task-workbench app (entry page, three /apps/task-workbench pages, app-scoped tools) and forwards publishes to the host task center over declared hard injects; use it as the template for writing new Veren applications, not as a library.",
  "version": "2.1.8",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.cn.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {},
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-storage": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-storage-json": ">=0.2.1-rc.2 <0.3.0",
    "@veren/app-registry": "workspace:^",
    "@veren/page-registry": "workspace:^",
    "@veren/prompt-page": "workspace:^",
    "@veren/task-center": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@veren/prompt-core": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@veren/app-registry": "workspace:^",
    "@veren/page-registry": "workspace:^",
    "@veren/prompt-core": "workspace:^",
    "@veren/prompt-page": "workspace:^",
    "@veren/task-center": "workspace:^",
    "typescript": "^5.6.0",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
