{
  // 构建配置：把 src/*.ts(x) 发射为 dist/*.js 与 dist/*.d.ts。
  // Build config: emit src/*.ts(x) as dist/*.js plus dist/*.d.ts.
  //
  // 源码按本仓库惯例用 `.ts` 后缀互相导入；`rewriteRelativeImportExtensions`
  // 在发射时把它们改写成 Node 可加载的 `.js`，因此无需再改源码。
  // Sources import each other with `.ts` specifiers per house style;
  // `rewriteRelativeImportExtensions` rewrites them to loadable `.js` on emit,
  // so the sources stay untouched.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    // 清空 typecheck 用的 paths 源码钉住：钉住会把兄弟包源码拖进本包程序，
    // 违反 rootDir；构建按 node_modules 解析到兄弟包的 dist 类型即可。
    // Clear the typecheck-only source pins: they would drag sibling sources
    // into this program and violate rootDir; the build resolves siblings'
    // dist types through node_modules instead.
    "paths": {}
  },
  "include": ["src"]
}
