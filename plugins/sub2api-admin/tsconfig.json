{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@veren/prompt-core",
    "skipLibCheck": true,
    "paths": {
      // The workspace sibling's checked-in `dist/` can lag its sources (build
      // artifacts are not kept in git); pinning the checker to the sources keeps
      // the current API authoritative. Vitest aliases the same specifier.
      // 工作区兄弟包入库的 `dist/` 会落后于其源码（构建产物不入库）；把检查器钉到
      // 源码上，以当前 API 为权威。vitest 把同一说明符别名到同一处。
      "@veren/prompt-page": ["../../packages/prompt-page/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "vitest.config.ts"]
}
