{
  "name": "@veren/web-login-gate",
  "displayName": "Veren Web Login Gate",
  "version": "3.0.0-rc.1",
  "description": "Use when the dsh Web GUI must require a named user login before any page or API access: it mounts the @veren/auth-core framework (email + password sign-in) over a @veren/orm sqlite database, gates the SPA entry and every /api request behind a valid session, and only then lets the official launch-token exchange mint its browser cookies; skip it when the anonymous per-process launch-token gate is enough.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.cn.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "test": "vitest run --no-fsModuleCache"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@veren/auth-core": "workspace:*",
    "@veren/orm": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@types/node": "^26.6.5",
    "vitest": "^5.0.4"
  }
}
