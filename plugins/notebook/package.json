{
  "name": "@veren/notebook",
  "displayName": "Notebook",
  "version": "0.2.0",
  "icon": "./icon.svg",
  "description": "Use when a DSH deployment needs the notebook domain itself: one private durable notebook per agent preset, served to people over the notebook Remote namespace and to models through exported tool builders that a mounter registers; this package registers no tools itself - install @veren/notebook-app to expose the notebook under /apps/notebook with notebook__* page tools (the replacement for the global notebook_* tools retired in 0.2.0). Skip it when agents need no private scratchpad.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/*.js",
    "README.md",
    "README.cn.md",
    "icon.svg",
    "locale/*.json"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {},
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run --no-fsModuleCache"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@veren/core": "workspace:^",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@veren/core": "workspace:^",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
