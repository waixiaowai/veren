{
  // Type-checking only: emission is `scripts/build.mjs`, which transpiles each
  // source file with the Harness checkout's own TypeScript.
  //
  // 仅做类型检查：产物由 `scripts/build.mjs` 用检出仓库自带的 TypeScript 逐文件转译。
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "composite": false,
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "experimentalDecorators": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
