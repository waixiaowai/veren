{
  "name": "@veren/opencode-go",
  "description": "Use when a dsh composition must serve the OpenCode Go subscription plan as a first-class model route: it registers a dedicated opencode-go provider adapter (OpenAI-compatible wire against opencode.ai/inference/go) with a guided sign-in flow that provisions the plan API key through the harness authorization and credential seams; skip it when the deployment has no OpenCode Go subscription.",
  "version": "2.2.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.cn.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "vitest run --no-fsModuleCache"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-authorization": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
