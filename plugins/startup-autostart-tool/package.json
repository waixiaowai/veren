{
  "name": "@veren/startup-autostart-tool",
  "displayName": "Startup Autostart Tools",
  "version": "2.1.1",
  "icon": "./icon.svg",
  "description": "Use when agents need model-facing startup item management tools backed by the separately installed Startup Autostart host service; omit it when startup items should run without being editable by agents.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/*.js",
    "README.md",
    "README.cn.md",
    "icon.svg",
    "locale/*.json"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {},
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run --no-fsModuleCache"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@veren/startup-autostart": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@veren/startup-autostart": "workspace:^",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
