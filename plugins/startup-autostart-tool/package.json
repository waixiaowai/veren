{
  "name": "@veren/startup-autostart-tool",
  "displayName": "Startup Autostart Tools",
  "version": "1.4.0",
  "icon": "./icon.svg",
  "description": "Use when agents need model-facing startup item management tools backed by the separately installed Startup Autostart host service; omit it when startup items should run without being editable by agents.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.cn.md",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@veren/startup-autostart": "^1.3.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "license": "MIT"
}
