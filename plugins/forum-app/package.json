{
  "name": "@veren/forum-app",
  "displayName": "Forum-应用",
  "version": "0.1.1",
  "description": "Use when a DSH deployment hosts the forum service and wants it visible as a first-class application: registers the forum app (a board/post catalog entry page plus a post detail page under /apps/forum) in the host app catalog with app-scoped forum__* page tools, acting through the @veren/forum service's tools port; skip it when only the headless forum service is wanted - the host package works alone and this package needs the application framework to activate.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.cn.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {},
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.2 <0.3.0",
    "@veren/app-registry": "workspace:^",
    "@veren/forum": "workspace:^",
    "@veren/prompt-page": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@veren/app-registry": "workspace:^",
    "@veren/forum": "workspace:^",
    "@veren/page-registry": "workspace:^",
    "@veren/prompt-core": "workspace:^",
    "@veren/prompt-page": "workspace:^",
    "typescript": "^5.6.0",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
